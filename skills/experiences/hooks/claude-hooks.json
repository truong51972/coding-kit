{
  "description": "Optional experience index and advisory failure-loop detection (Bash only).",
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|compact|fork",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${AGENTS_HOME:-$HOME/.agents}/skills/experiences/hooks/experience_provider.py\"",
            "timeout": 3
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${AGENTS_HOME:-$HOME/.agents}/skills/experiences/hooks/experience_provider.py\"",
            "timeout": 3
          }
        ]
      }
    ],
    "PostToolUseFailure": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${AGENTS_HOME:-$HOME/.agents}/skills/experiences/hooks/experience_provider.py\"",
            "timeout": 3
          }
        ]
      }
    ]
  }
}
